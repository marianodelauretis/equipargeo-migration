---
// Formulario de consulta al pie de las notas. No tiene backend ni guarda datos:
// arma un texto y abre WhatsApp para que el mensaje lo mande el propio lector.
export interface Props {
  tituloNota?: string;
}

const { tituloNota = '' } = Astro.props;
const numero = '5491155722266';
---
<section
  class="container-eg max-w-3xl mt-10 md:mt-12"
  aria-labelledby="consulta-nota-titulo"
>
  <div class="p-6 md:p-7 bg-eg-bg-soft border border-eg-borde rounded-2xl">
    <h3 id="consulta-nota-titulo" class="text-eg-azul font-bold text-xl mb-1.5">
      ¿Tenés una consulta o querés dar tu opinión?
    </h3>
    <p class="text-eg-text-muted text-sm mb-4">
      Contanos tu experiencia con este equipo, tus dudas, o en qué no coincidís con lo que vimos.
      Te respondemos por WhatsApp.
    </p>

    <form class="flex flex-col gap-3" data-consulta-nota data-titulo-nota={tituloNota} data-numero={numero}>
      <div class="grid sm:grid-cols-2 gap-3">
        <div class="flex flex-col gap-1.5">
          <label for="consulta-nombre" class="text-sm font-bold text-eg-azul">
            Nombre <span class="font-normal text-eg-gris">(opcional)</span>
          </label>
          <input
            type="text"
            id="consulta-nombre"
            name="nombre"
            autocomplete="name"
            placeholder="Cómo te llamás"
            class="w-full px-3 py-2.5 rounded-xl border border-eg-borde bg-white text-eg-text-main text-sm placeholder:text-eg-gris focus:outline-none focus:border-eg-azul"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="consulta-tema" class="text-sm font-bold text-eg-azul">
            Tema <span class="font-normal text-eg-gris">(opcional)</span>
          </label>
          <input
            type="text"
            id="consulta-tema"
            name="tema"
            placeholder="Precio, alcance, compatibilidad…"
            class="w-full px-3 py-2.5 rounded-xl border border-eg-borde bg-white text-eg-text-main text-sm placeholder:text-eg-gris focus:outline-none focus:border-eg-azul"
          />
        </div>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="consulta-mensaje" class="text-sm font-bold text-eg-azul">Mensaje</label>
        <textarea
          id="consulta-mensaje"
          name="mensaje"
          rows="4"
          required
          placeholder="Contanos tu consulta, tu experiencia o tu opinión."
          class="w-full px-3 py-2.5 rounded-xl border border-eg-borde bg-white text-eg-text-main text-sm leading-relaxed placeholder:text-eg-gris focus:outline-none focus:border-eg-azul resize-y"
        ></textarea>
      </div>

      <div>
        <button type="submit" class="btn-eg-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/>
          </svg>
          Enviar por WhatsApp
        </button>
      </div>

      <p class="text-xs text-eg-gris leading-relaxed">
        Al enviar se abre WhatsApp con tu mensaje ya escrito. No guardamos tus datos:
        el mensaje lo mandás vos desde tu propio WhatsApp.
      </p>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll('form[data-consulta-nota]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const el = form as HTMLFormElement;
      const valor = (name: string) =>
        (el.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null)?.value.trim() ?? '';

      const mensaje = valor('mensaje');
      if (!mensaje) return;

      const titulo = el.dataset.tituloNota ?? '';
      const numero = el.dataset.numero ?? '';
      const nombre = valor('nombre');
      const tema = valor('tema');

      const partes = [
        titulo ? `Hola EQUIPAR, les escribo por la nota "${titulo}".` : 'Hola EQUIPAR, les escribo por una nota del sitio.',
        nombre ? `Nombre: ${nombre}.` : '',
        tema ? `Tema: ${tema}.` : '',
        mensaje,
      ].filter(Boolean);

      window.open(`https://wa.me/${numero}?text=${encodeURIComponent(partes.join(' '))}`, '_blank', 'noopener');
    });
  });
</script>
